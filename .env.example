# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# On Vercel, set these in Project Settings → Environment Variables
# (or run `vercel env pull` to sync them down).
# ---------------------------------------------------------------------------

# Canonical origin. Absolute, including the scheme.
# Drives canonical tags, sitemap.xml, robots.txt, and OG image URLs.
#
# Leave this unset unless you have a real domain. Unset is a supported state:
# the app falls back to the Vercel deployment URL, then to siteConfig.url.
# Setting it to a placeholder like https://example.com publishes canonical tags
# pointing at a domain you do not own.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery.
#   log      → validate and log only; nothing is sent (default in development)
#   provider → send over SMTP (default in production)
# Leave this unset in Production. Set it to `log` on Preview if you do not want
# test deployments emailing real leads.
CONTACT_DELIVERY_MODE=log

# ---------------------------------------------------------------------------
# SMTP — required whenever CONTACT_DELIVERY_MODE resolves to `provider`.
# The values below are Hostinger's; see src/lib/mailer.ts.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.hostinger.com

# 465 with implicit TLS is Hostinger's recommended pairing. Switch to 587 if
# your host or network blocks 465 — SMTP_SECURE follows the port automatically,
# so there is nothing else to change.
SMTP_PORT=465

# Optional. Defaults to `true` on port 465 and `false` on 587, which is what
# each port expects. Only set it if you need to override that.
# SMTP_SECURE=true

# Your full Hostinger mailbox address and its password.
# SMTP_PASSWORD is the only real secret here — mark it Sensitive in Vercel.
SMTP_USER=contact@tokyo2ch.ch
SMTP_PASSWORD=

# Optional. Where enquiries land, and the address they are sent from.
# Default: siteConfig.contact.email for the recipient, SMTP_USER for the sender.
# Hostinger rejects a sender that is not a mailbox on the authenticated domain,
# so overriding CONTACT_FROM_EMAIL is rarely what you want.
# CONTACT_TO_EMAIL=contact@tokyo2ch.ch
# CONTACT_FROM_EMAIL=contact@tokyo2ch.ch
