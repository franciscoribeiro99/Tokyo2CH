# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# On Vercel, set these in Project Settings → Environment Variables
# (or run `vercel env pull` to sync them down).
# ---------------------------------------------------------------------------

# Canonical origin. Absolute, no trailing slash.
# Drives canonical tags, sitemap.xml, robots.txt, and OG image URLs.
# Leave unset locally — the app falls back to the Vercel URL, then siteConfig.url.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery.
#   log      → validate and log only; nothing is sent (default in development)
#   provider → call deliver() in src/app/actions/contact.ts (default in production)
# Production throws unless you implement deliver(), so leads never fail silently.
CONTACT_DELIVERY_MODE=log

# Add your email provider credentials here once you have provisioned one from
# the Vercel Marketplace, then wire them into deliver().
# RESEND_API_KEY=
